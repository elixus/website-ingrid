---
interface Props {
	heading: string;
	Content: any;
}

const { heading, Content } = Astro.props;
---

<section id="aanbod" class="services">
  <div class="services__inner">
    <header class="services__header">
      <div class="iching-divider">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <h2 class="services__heading">{heading}</h2>
      <div class="services__intro prose">
        <Content />
      </div>
    </header>
  </div>
</section>

<style>
  .services {
    padding: 6rem 1.5rem;
    background-color: var(--color-surface);
    position: relative;
  }

  .services__inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .services__header {
    margin-bottom: 3.5rem;
    max-width: 40rem;
  }

  .services__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    font-style: italic;
    color: var(--color-text);
    margin: 1rem 0 1.5rem;
  }

  .services__intro {
    font-size: 1rem;
  }
</style>
