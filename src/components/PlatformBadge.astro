---
interface Props {
	lang?: "nl" | "en";
}

const { lang = "nl" } = Astro.props;

const schedule =
	lang === "en"
		? "Mon · Wed · Thu · Fri"
		: "Ma · Wo · Do · Vr";

const scheduleLabel =
	lang === "en" ? "Available" : "Beschikbaar";
---

<div class="platform-badge">
  <p class="platform-badge__schedule">
    <span class="platform-badge__schedule-label">{scheduleLabel}</span>
    {schedule}
  </p>
</div>

<style>
  .platform-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 0.75rem 1.5rem;
    padding-top: calc(5rem + 0.75rem); /* clear fixed nav (~80px) + own padding */
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-sand-light);
  }

  .platform-badge__schedule {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0;
  }

  .platform-badge__schedule-label {
    font-weight: 600;
    color: var(--color-sage);
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    margin-right: 0.5rem;
  }
</style>
