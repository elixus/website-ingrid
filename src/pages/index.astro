---
import { getEntry, render } from "astro:content";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import PlatformBadge from "../components/PlatformBadge.astro";
import Practical from "../components/Practical.astro";
import Services from "../components/Services.astro";
import Topics from "../components/Topics.astro";
import Layout from "../layouts/Layout.astro";

const lang = "nl";

const [
	heroEntry,
	aboutEntry,
	servicesEntry,
	topicsEntry,
	practicalEntry,
	contactEntry,
] = await Promise.all([
	getEntry("hero", lang),
	getEntry("about", lang),
	getEntry("services", lang),
	getEntry("topics", lang),
	getEntry("practical", lang),
	getEntry("contact", lang),
]);

const { Content: HeroContent } = await render(heroEntry);
const { Content: AboutContent } = await render(aboutEntry);
const { Content: ServicesContent } = await render(servicesEntry);
const { Content: TopicsContent } = await render(topicsEntry);
const { Content: PracticalContent } = await render(practicalEntry);
const { Content: ContactContent } = await render(contactEntry);
---

<Layout
  title="Ingrid De Wilde — Psycholoog / Psychotherapeut te Huldenberg"
  description="Klinisch psycholoog en psychotherapeut te Huldenberg. Individuele begeleiding, relatietherapie en workshops voor volwassenen. Online consultaties mogelijk."
  lang="nl"
>
  <PlatformBadge lang="nl" />

  <Hero
    name={heroEntry.data.name}
    title={heroEntry.data.title}
    tagline={heroEntry.data.tagline}
    subtitle={heroEntry.data.subtitle}
    Content={HeroContent}
  />

  <About
    heading={aboutEntry.data.heading}
    credentials={aboutEntry.data.credentials}
    Content={AboutContent}
  />

  <Services
    heading={servicesEntry.data.heading}
    services={servicesEntry.data.services}
    Content={ServicesContent}
  />

  <Topics
    heading={topicsEntry.data.heading}
    topics={topicsEntry.data.topics}
    Content={TopicsContent}
  />

  <Practical
    heading={practicalEntry.data.heading}
    rates={practicalEntry.data.rates}
    session={practicalEntry.data.session}
    noConsultations={practicalEntry.data.noConsultations}
    languages={practicalEntry.data.languages}
    Content={PracticalContent}
  />

  <Contact
    heading={contactEntry.data.heading}
    address={contactEntry.data.address}
    phone={contactEntry.data.phone}
    email={contactEntry.data.email}
    Content={ContactContent}
    lang="nl"
  />
</Layout>
